{
  "$schema": "https://repomix.com/schema/repomix.config.json",
  "output": {
    "filePath": "bundle.xml",
    "style": "xml",
    "removeComments": false,
    "removeEmptyLines": true,
    "compress": false,
    "showLineNumbers": false,
    "topFilesLength": 5,
    "includeEmptyDirectories": false,
    "instructionFilePath": "prompts/BUNDLE-HEADER.md"
  },
  "include": [],
  "ignore": {
    "useGitignore": true,
    "useDefaultPatterns": true,
    "customPatterns": [
      ".claude/",
      "docs/",
      "bundle.xml",
      "bundle.md",
      "repomix.config.json",
      ".repomixignore",
      "prompts/BUNDLE-HEADER.md"
    ]
  },
  "security": {
    "enableSecurityCheck": true
  }
}
